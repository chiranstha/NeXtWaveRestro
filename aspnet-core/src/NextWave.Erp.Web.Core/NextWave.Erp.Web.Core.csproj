    <PackageReference Include="Hangfire.SqlServer" Version="1.8.24" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Owl.reCAPTCHA" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Abp.AspNetCore" Version="10.5.0" />
    <PackageReference Include="Abp.HangFire.AspNetCore" Version="10.5.0" />
    <PackageReference Include="Abp.RedisCache" Version="10.5.0" />
