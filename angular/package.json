{
  "name": "abp-zero-template",
  "version": "13.3.0",
  "license": "MIT",
  "angular-cli": {},
  "scripts": {
    "ng": "ng",
    "publish": "gulp build && ng build --configuration production && npm run track:bundle",
    "analyze": "gulp build && ng build --configuration production --stats-json && npx webpack-bundle-analyzer dist/stats.json",
    "build:prod": "gulp build && ng build --configuration production && npm run track:bundle",
    "build:analyze": "gulp build && ng build --configuration production --stats-json && npx webpack-bundle-analyzer dist/stats.json",
    "build:optimize": "gulp build && ng build --configuration production && npm run track:bundle && npm run gzip:analyze",
    "gzip:analyze": "npx gzip-size dist/**/*.js dist/**/*.css",
    "optimize:images": "node scripts/optimize-images.js",
    "track:bundle": "node scripts/track-bundle-size.js",
    "purge:css": "purgecss --config purgecss.config.js",
    "lint": "eslint src",
    "post-publish": "shx mv ./wwwroot/dist/* ./wwwroot/",
    "publish-k8s": "gulp build && ng build --configuration k8s --verbose",
    "start": "node --max-old-space-size=8096 ./node_modules/@angular/cli/bin/ng serve --host 0.0.0.0 --port 4200",
    "hmr": "gulp buildDev && ng serve --host 0.0.0.0 --port 4200 --hmr",
    "test": "gulp buildDev && ng test",
    "create-dynamic-bundles": "gulp buildDev",
    "nswag": "cd nswag/ && refresh.bat"
  },
  "private": false,
  "type": "module",
