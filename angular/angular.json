{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "abp-zero-template": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
            "options": {
              "allowedCommonJsDependencies": [
                "@angularclass/hmr",
                "rtl-detect",
                "object-path",
                "angular2-text-mask",
                "angular2-counto",
                "rxjs/internal/observable/throwError",
                "adal-angular/lib/adal",
                "rfdc",
                "localforage",
                "quill-delta",
                "push.js",
                "pako"
              ],
              "outputPath": {
                "base": "dist"
              },
              "index": "src/index.html",
              "tsConfig": "src/tsconfig.app.json",
              "polyfills": [
                "src/polyfills.ts"
              ],
              "preserveSymlinks": false,
              "assets": [
               
                "src/assets",
                "src/metronic",
                "src/favicon.ico",
                {
                  "glob": "abp.signalr-client.js",
                  "input": "node_modules/abp-web-resources/Abp/Framework/scripts/libs",
                  "output": "/assets/abp"
                },
                
               
                {
                  "glob": "**/*",
                  "input": "node_modules/ngx-extended-pdf-viewer/assets/",
                  "output": "/assets/"
                },
                {
                  "glob": "**/*",
                  "input": "node_modules/ngx-extended-pdf-viewer/bleeding-edge/",
                  "output": "/bleeding-edge/"
                }
              ],
              "styles": [
                "node_modules/ngx-spinner/animations/ball-clip-rotate.css",
                "src/assets/metronic/common/fonts/keenthemes-icons/ki.css",
                "src/assets/metronic/fontawesome/fontawesome.css",
                "src/assets/metronic/fonts/fonts.scss",
                "src/assets/ngx-bootstrap/bs-datepicker.css",
                "node_modules/ag-grid-community/styles/ag-grid.css",
                "node_modules/ag-grid-community/styles/ag-theme-balham.css",

                "src/app/shared/core.less",
                "src/app/shared/layout/layout.less",
                "src/styles-complete-optimized.css",
                "src/styles-override.css",
                "node_modules/sweetalert2/dist/sweetalert2.css",
                "node_modules/famfamfam-flags/dist/sprite/famfamfam-flags.css",
                "node_modules/quill/dist/quill.core.css",
                "node_modules/quill/dist/quill.snow.css"
              ],
              "scripts": [
                "node_modules/@microsoft/signalr/dist/browser/signalr.min.js",
                "node_modules/localforage/dist/localforage.js",
                "node_modules/push.js/bin/push.js",
                "src/assets/abp-web-resources/abp.js",
                "src/assets/abp-web-resources/abp.sweet-alert.js",
                "src/assets/abp-web-resources/abp.notify.js",
                "src/assets/canvas-toBlob/canvas-toBlob.js",
                "src/assets/metronic/common/js/components/menu.js",
                "src/assets/metronic/common/js/components/scrolltop.js",
                "src/assets/metronic/common/js/components/toggle.js",
                "src/assets/metronic/common/js/components/util.js",
                "src/assets/metronic/common/js/components/app.js",
                "node_modules/sweetalert2/dist/sweetalert2.js",
                "node_modules/quill/dist/quill.js"
              ],
              "browser": "src/main.ts"
            },
            "configurations": {
              "development": {
                "sourceMap": true,
                "optimization": false,
                "outputHashing": "none",
                "extractLicenses": false,
                "namedChunks": true,
                "aot": false
              },
              "production": {
                "optimization": {
                  "scripts": true,
                  "styles": {
                    "minify": true,
                    "inlineCritical": true
                  },
                  "fonts": true
                },
                "outputHashing": "all",
                "sourceMap": false,
                "namedChunks": false,
                "extractLicenses": true,
                "aot": true,
                "serviceWorker": "ngsw-config.json",
                "fileReplacements": [
                  {
                    "replace": "src/environments/environment.ts",
                    "with": "src/environments/environment.prod.ts"
                  }
                ],
                "budgets": [
                  {
                    "type": "initial",
                    "maximumWarning": "7mb",
                    "maximumError": "8mb"
                  },
                  {
                    "type": "anyComponentStyle",
                    "maximumWarning": "30kb",
                    "maximumError": "40kb"
                  }
                ]
              },
              "k8s": {
                "optimization": true,
                "outputHashing": "all",
                "sourceMap": false,
                "namedChunks": true,
                "extractLicenses": true,
                "fileReplacements": [
                  {
                    "replace": "src/environments/environment.ts",
                    "with": "src/environments/environment.k8s.ts"
                  }
                ],
                "budgets": [
                  {
                    "type": "initial",
                    "maximumWarning": "7mb",
                    "maximumError": "10mb"
                  },
                  {
                    "type": "anyComponentStyle",
                    "maximumWarning": "30kb"
                  }
                ]
              }
            },
            "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "abp-zero-template:build"
          },
          "configurations": {
            "development": {
              "buildTarget": "abp-zero-template:build:development"
            },
            "production": {
              "buildTarget": "abp-zero-template:build:production"
            },
            "k8s": {
              "buildTarget": "abp-zero-template:build:k8s"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "abp-zero-template:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "src/tsconfig.spec.json",
            "main": "src/test.ts",
            "karmaConfig": "./karma.conf.js",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "styles": [
              "node_modules/animate.css/animate.min.css",
              "node_modules/quill/dist/quill.core.css",
              "node_modules/quill/dist/quill.snow.css",
              "node_modules/famfamfam-flags/dist/sprite/famfamfam-flags.css",
              "node_modules/sweetalert2/dist/sweetalert2.css",
              "node_modules/cookieconsent/build/cookieconsent.min.css",
              "node_modules/ngx-spinner/animations/ball-clip-rotate.css",
              "src/assets/metronic/common/fonts/keenthemes-icons/ki.css",
              "src/assets/metronic/fontawesome/fontawesome.css",
               "src/assets/metronic/fonts/fonts.scss",
              "src/assets/ngx-bootstrap/bs-datepicker.css",
              "node_modules/ag-grid-community/styles/ag-grid.css",
              "node_modules/ag-grid-community/styles/ag-theme-balham.css",
              "src/app/shared/core.less",
              "src/app/shared/layout/layout.less",
              "src/styles-complete-optimized.css",
              "src/styles-override.css"
                       ],
            "scripts": [
              "node_modules/@microsoft/signalr/dist/browser/signalr.min.js",
              "node_modules/localforage/dist/localforage.js",
              "node_modules/push.js/bin/push.js",
              "node_modules/quill/dist/quill.js",
              "node_modules/sweetalert2/dist/sweetalert2.js",
              "node_modules/cookieconsent/build/cookieconsent.min.js",
              "src/assets/abp-web-resources/abp.js",
              "src/assets/abp-web-resources/abp.sweet-alert.js",
              "src/assets/abp-web-resources/abp.notify.js",
              "src/assets/canvas-toBlob/canvas-toBlob.js",
              "src/assets/metronic/common/js/components/menu.js",
              "src/assets/metronic/common/js/components/scrolltop.js",
              "src/assets/metronic/common/js/components/toggle.js",
              "src/assets/metronic/common/js/components/util.js",
              "src/assets/metronic/common/js/components/app.js"
            ],
            "assets": [
              "src/assets",
              "src/favicon.ico",
              {
                "glob": "abp.signalr-client.js",
                "input": "node_modules/abp-web-resources/Abp/Framework/scripts/libs",
                "output": "/assets/abp"
              },
             
             
              {
                "glob": "**/*",
                "input": "node_modules/ngx-extended-pdf-viewer/assets/",
                "output": "/assets/"
              },
              {
                "glob": "**/*",
                "input": "node_modules/ngx-extended-pdf-viewer/bleeding-edge/",
                "output": "/bleeding-edge/"
              }
            ]
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "app",
      "style": "css",
      "type": "component"
    },
    "@schematics/angular:directive": {
      "prefix": "app",
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "cli": {
    "analytics": "b527a179-d14f-499c-b002-96792c1108b6",
    "packageManager": "npm"
  }
}
